<Window x:Class="HHCORP_HRM.DuyetNghiPhepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duyệt Nghỉ Phép"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <TextBlock Grid.Row="0"
                       Text="Duyệt Nghỉ Phép"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"/>

            <!-- DataGrid -->
            <DataGrid x:Name="dgvNghiPhep"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="0,0,0,15"
                      RowBackground="#F9F9F9"
                      AlternatingRowBackground="#FFFFFF"
                      BorderThickness="0"
                      HeadersVisibility="Column">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4A90E2"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#D3D3D3"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Nghỉ Phép" Binding="{Binding MaNghiPhep}" Width="100"/>
                    <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="80"/>
                    <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="150"/>
                    <DataGridTextColumn Header="Ngày Bắt Đầu" Binding="{Binding NgayBatDau, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                    <DataGridTextColumn Header="Ngày Kết Thúc" Binding="{Binding NgayKetThuc, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                    <DataGridTextColumn Header="Lý Do" Binding="{Binding LyDo}" Width="*"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding TrangThai}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Lý do từ chối -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15" Visibility="Collapsed" x:Name="spLyDoTuChoi">
                <Label Content="Lý do từ chối:" FontWeight="Medium" FontSize="14" Foreground="#333"/>
                <TextBox x:Name="txtLyDoTuChoi" Width="500" Height="30" FontSize="14" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Nút điều khiển -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnDuyet"
                        Content="Duyệt"
                        Width="100"
                        Height="35"
                        Background="#50C878"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Medium"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="btnDuyet_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3DA65F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="btnTuChoi"
                        Content="Từ Chối"
                        Width="100"
                        Height="35"
                        Background="#FF6F61"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Medium"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="btnTuChoi_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E05548"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="btnHuy"
                        Content="Hủy"
                        Width="100"
                        Height="35"
                        Background="#808080"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Medium"
                        Cursor="Hand"
                        Click="btnHuy_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#666666"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>