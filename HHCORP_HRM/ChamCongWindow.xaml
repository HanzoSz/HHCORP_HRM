<Window x:Class="HHCORP_HRM.ChamCongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Chấm Công"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Tiêu đề -->
                <RowDefinition Height="Auto"/>
                <!-- Webcam và nhận diện -->
                <RowDefinition Height="Auto"/>
                <!-- DataGrid và nút điều khiển DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Form nhập liệu và nút nhập liệu -->
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <Border Grid.Row="0" Background="#4A90E2" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Quản Lý Chấm Công"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button x:Name="btnQuayLai"
                            Content="Quay Lại"
                            Width="100"
                            Height="35"
                            Background="#FF6F61"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Medium"
                            Cursor="Hand"
                            Grid.Column="1"
                            Click="btnQuayLai_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E05548"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Khu vực webcam và nhận diện -->
            <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#D3D3D3" BorderThickness="1" CornerRadius="3" Height="200">
                        <Image x:Name="WebcamFeed" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="btnNhanDien"
                                Content="Nhận Diện Khuôn Mặt"
                                Width="150"
                                Height="35"
                                Background="#4A90E2"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Margin="0,0,0,10"
                                Click="btnNhanDien_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#357ABD"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btnRegisterFaces"
                                Content="Đăng Ký Khuôn Mặt"
                                Width="150"
                                Height="35"
                                Background="#50C878"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Click="btnRegisterFaces_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3DA65F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid và nút điều khiển DataGrid -->
            <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgvChamCong"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="dgvChamCong_SelectionChanged"
                              Margin="0,0,0,10"
                              Grid.Row="0"
                              RowBackground="#F9F9F9"
                              AlternatingRowBackground="#FFFFFF"
                              BorderThickness="0"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#4A90E2"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#D3D3D3"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Chấm Công" Binding="{Binding MaChamCong}" Width="100"/>
                            <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="80"/>
                            <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="150"/>
                            <DataGridTextColumn Header="Ngày Chấm Công" Binding="{Binding NgayChamCong, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Thời Gian Vào" Binding="{Binding ThoiGianVao, StringFormat={}{0:HH:mm}}" Width="100"/>
                            <DataGridTextColumn Header="Thời Gian Ra" Binding="{Binding ThoiGianRa, StringFormat={}{0:HH:mm}}" Width="100"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding TrangThai}" Width="120"/>
                            <DataGridTextColumn Header="Ghi Chú" Binding="{Binding GhiChu}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnXoa"
                                Content="Xóa"
                                Width="100"
                                Height="35"
                                Background="#FF6F61"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                Click="btnXoa_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E05548"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btnLamMoi"
                                Content="Làm Mới"
                                Width="100"
                                Height="35"
                                Background="#FFA500"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Click="btnLamMoi_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E59400"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Form nhập liệu và nút nhập liệu -->
            <Border Grid.Row="3" Background="White" CornerRadius="5" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form nhập liệu -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột bên trái -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Mã Nhân Viên (*)" FontWeight="Medium" FontSize="14" Foreground="#333"/>
                            <ComboBox x:Name="cbMaNV" Margin="0,0,0,10" Height="30" FontSize="14" SelectionChanged="cbMaNV_SelectionChanged"/>

                            <Label Content="Họ Tên Nhân Viên" FontWeight="Medium" FontSize="14" Foreground="#333"/>
                            <TextBox x:Name="txtHoTen" Margin="0,0,0,10" Height="30" FontSize="14" IsReadOnly="True" Background="#F0F0F0"/>

                            <Label Content="Thời Gian Vào (*)" FontWeight="Medium" FontSize="14" Foreground="#333"/>
                            <DatePicker x:Name="dpThoiGianVao" Margin="0,0,0,10" Height="30" FontSize="14"/>
                        </StackPanel>

                        <!-- Cột bên phải -->
                        <StackPanel Grid.Column="1">
                            <Label Content="Thời Gian Ra" FontWeight="Medium" FontSize="14" Foreground="#333"/>
                            <DatePicker x:Name="dpThoiGianRa" Margin="0,0,0,10" Height="30" FontSize="14"/>

                            <Label Content="Trạng Thái (*)" FontWeight="Medium" FontSize="14" Foreground="#333"/>
                            <ComboBox x:Name="cbTrangThai" Margin="0,0,0,10" Height="30" FontSize="14">
                                <ComboBoxItem Content="Thành công"/>
                                <ComboBoxItem Content="Lỗi"/>
                                <ComboBoxItem Content="Chờ xử lý"/>
                            </ComboBox>

                            <Label Content="Ghi Chú" FontWeight="Medium" FontSize="14" Foreground="#333"/>
                            <TextBox x:Name="txtGhiChu" Margin="0,0,0,10" Height="60" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Nút điều khiển form -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button x:Name="btnThem"
                                Content="Thêm"
                                Width="100"
                                Height="35"
                                Background="#50C878"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Margin="0,0,0,10"
                                Click="btnThem_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3DA65F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btnSua"
                                Content="Sửa"
                                Width="100"
                                Height="35"
                                Background="#4A90E2"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Click="btnSua_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#357ABD"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>