<Window x:Class="HHCORP_HRM.XuatBaoCaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất Báo Cáo"
        Width="500" Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0"
                   Text="Xuất Báo Cáo"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- Chọn loại báo cáo -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Loại Báo Cáo:" Width="120" FontSize="14"/>
            <ComboBox x:Name="cbLoaiBaoCao" Width="200" FontSize="14" SelectionChanged="cbLoaiBaoCao_SelectionChanged">
                <ComboBoxItem Content="Chấm công"/>
                <ComboBoxItem Content="Nhân sự"/>
                <ComboBoxItem Content="Lương"/>
            </ComboBox>
        </StackPanel>

        <!-- Chọn nhân viên -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Nhân Viên:" Width="120" FontSize="14"/>
            <ComboBox x:Name="cbNhanVien" Width="200" FontSize="14"/>
        </StackPanel>

        <!-- Ngày bắt đầu -->
        <StackPanel x:Name="spNgayBatDau" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Visible">
            <Label Content="Ngày Bắt Đầu:" Width="120" FontSize="14"/>
            <DatePicker x:Name="dpNgayBatDau" Width="200" FontSize="14"/>
        </StackPanel>

        <!-- Ngày kết thúc -->
        <StackPanel x:Name="spNgayKetThuc" Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Visible">
            <Label Content="Ngày Kết Thúc:" Width="120" FontSize="14"/>
            <DatePicker x:Name="dpNgayKetThuc" Width="200" FontSize="14"/>
        </StackPanel>

        <!-- Nút điều khiển -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnXuatBaoCao"
                    Content="Xuất Báo Cáo"
                    Width="120"
                    Height="35"
                    Background="#4A90E2"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Medium"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="btnXuatBaoCao_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5"
                                            Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#357ABD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnHuy"
                    Content="Hủy"
                    Width="120"
                    Height="35"
                    Background="#808080"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Medium"
                    Cursor="Hand"
                    Click="btnHuy_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5"
                                            Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#666666"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>